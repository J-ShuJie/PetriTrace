<Window x:Class="PiCameraControl.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PiCameraControl.Manager.Core.Localization;assembly=PiCameraControl.Manager.Core"
        Title="PetriTrace" Width="1040" Height="720" MinWidth="840" MinHeight="620"
        WindowStyle="None" StateChanged="Window_StateChanged" WindowStartupLocation="CenterScreen" Icon="Assets/app-icon.ico"
        DataContext="{x:Static loc:LocalizationService.Instance}"
        AutomationProperties.Name="{Binding [Window.AutomationName]}">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="46" /><Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" /><Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" />
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E7EDF4" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="#DBEAFE" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="WindowFrame" BorderBrush="#9AA7B6" BorderThickness="1">
  <Grid x:Name="WindowLayout">
    <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,12,0">
          <Image Source="Assets/app-icon.png" Width="24" Height="24" Margin="0,0,10,0" />
          <TextBlock Text="PetriTrace" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Border x:Name="HeaderStatusPill" VerticalAlignment="Center" Padding="10,5" Margin="0,0,16,0"
                CornerRadius="12" BorderThickness="1" BorderBrush="#A8C4E6" Background="#EEF6FF">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="HeaderStatusDot" Width="7" Height="7" Margin="0,0,7,0" Fill="#2563EB" />
            <TextBlock x:Name="HeaderStatusText" FontSize="12" Foreground="#173F73" Text="{Binding [Status.Initializing]}" />
          </StackPanel>
        </Border>
        <Border x:Name="OperationStatusPill" Visibility="Collapsed" VerticalAlignment="Center" Padding="10,5" Margin="0,0,12,0" CornerRadius="12" BorderThickness="1">
          <TextBlock x:Name="OperationStatusText" FontSize="12" MaxWidth="210" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Border>
        </StackPanel>
        <ComboBox Grid.Column="2" x:Name="LanguageSelect" Width="112" MinHeight="30" Height="30" Padding="6,3" Margin="0,0,16,0"
                  VerticalAlignment="Center" SelectedValuePath="Tag" SelectionChanged="LanguageSelect_SelectionChanged"
                  WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="{Binding [Language.AutomationName]}">
          <ComboBoxItem Content="简体中文" Tag="zh-CN" /><ComboBoxItem Content="English" Tag="en-US" /><ComboBoxItem Content="Deutsch" Tag="de-DE" />
        </ComboBox>
        <StackPanel Grid.Column="3" Orientation="Horizontal">
          <Button Style="{StaticResource CaptionButton}" Click="MinimizeWindow_Click" AutomationProperties.Name="{Binding [Window.Minimize]}" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" />
          <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="MaximizeWindow_Click" AutomationProperties.Name="{Binding [Window.Maximize]}" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" />
          <Button Style="{StaticResource CaptionButton}" Click="CloseWindow_Click" AutomationProperties.Name="{Binding [Window.Close]}" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border x:Name="NavigationPane" Width="220" Background="White"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"
              Visibility="Collapsed">
        <Grid Margin="18,22,18,18">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Margin="12,0,0,6" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource MutedTextBrush}" Text="{Binding [Nav.DeviceGroup]}" />
            <Button x:Name="DashboardNavButton" Style="{StaticResource NavigationButton}"
                    Click="DashboardNav_Click" Content="{Binding [Nav.Dashboard]}" />
            <Button x:Name="DeviceSettingsNavButton" Style="{StaticResource NavigationButton}"
                    Click="DeviceSettingsNav_Click" Content="{Binding [Nav.DeviceSettings]}" />

            <TextBlock Margin="12,24,0,6" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource MutedTextBrush}" Text="{Binding [Nav.MaintenanceGroup]}" />
            <Button x:Name="DiagnosticsNavButton" Style="{StaticResource NavigationButton}"
                    Click="DiagnosticsNav_Click" Content="{Binding [Nav.Diagnostics]}" />
            <Button x:Name="RepairNavButton" Style="{StaticResource NavigationButton}"
                    Click="RepairNav_Click" Content="{Binding [Nav.Repair]}" />

            <TextBlock Margin="12,24,0,6" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource MutedTextBrush}" Text="{Binding [Nav.AboutGroup]}" />
            <Button x:Name="NoticesNavButton" Style="{StaticResource NavigationButton}"
                    Click="NoticesNav_Click" Content="{Binding [Nav.Notices]}" />
            <Button x:Name="PrivacyNavButton" Style="{StaticResource NavigationButton}"
                    Click="PrivacyNav_Click" Content="{Binding [Nav.Privacy]}" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="1" Margin="32,24">
      <Grid x:Name="LoadingPanel">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
          <ProgressBar Height="4" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" />
          <TextBlock Margin="0,18,0,0" HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold"
                     Text="{Binding [Loading.Title]}" />
          <TextBlock Margin="0,8,0,0" TextAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
                     Text="{Binding [Loading.Detail]}" />
        </StackPanel>
      </Grid>

      <Grid x:Name="HomePanel" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
          <TextBlock x:Name="HomeDeviceName" Margin="0,6,0,0" FontSize="28" FontWeight="SemiBold" Text="{Binding [Device.DefaultName]}" />
          <TextBlock Text="{Binding [Home.CurrentConnection]}" Margin="0,12,0,0" Foreground="{StaticResource MutedTextBrush}" />
          <TextBlock x:Name="HomeEndpoint" Margin="0,4,0,18" TextWrapping="Wrap" />
          <TextBlock Text="{Binding [Home.LocalAddress]}" FontWeight="SemiBold" />
          <DockPanel Margin="0,4,0,4">
            <Button DockPanel.Dock="Right" x:Name="CopyLocalAddress" Click="CopyHomeAddress_Click" Content="{Binding [Home.CopyAddress]}" Margin="12,0,0,0" />
            <TextBox x:Name="HomeLocalAddress" IsReadOnly="True" VerticalContentAlignment="Center" />
          </DockPanel>
          <TextBlock x:Name="HomeLocalHelp" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,14" />
          <TextBlock Text="{Binding [Home.TailscaleAddress]}" FontWeight="SemiBold" />
          <DockPanel Margin="0,4,0,4">
            <Button DockPanel.Dock="Right" x:Name="CopyTailscaleAddress" Click="CopyHomeAddress_Click" Content="{Binding [Home.CopyAddress]}" Margin="12,0,0,0" />
            <TextBox x:Name="HomeTailscaleAddress" IsReadOnly="True" VerticalContentAlignment="Center" />
          </DockPanel>
          <TextBlock x:Name="HomeTailscaleHelp" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12" />
          <TextBlock x:Name="HomeCopyFeedback" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
          <WrapPanel>
            <Button Style="{StaticResource PrimaryButton}" Click="OpenControlPanel_Click" Content="{Binding [Action.OpenConsole]}" />
            <Button Click="RetryConnection_Click" Content="{Binding [Action.Retry]}" />
          </WrapPanel>
        </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,12,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                   Text="{Binding [Home.CloseDoesNotStop]}" />
      </Grid>

      <Grid x:Name="OfflinePanel" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="42" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Foreground="{StaticResource DangerBrush}" FontSize="13" FontWeight="SemiBold" Text="{Binding [Offline.Title]}" />
          <TextBlock x:Name="OfflineDeviceName" Margin="0,7,0,0" FontSize="27" FontWeight="SemiBold" Text="{Binding [Device.DefaultName]}" />
          <TextBlock Margin="0,10,0,22" Foreground="{StaticResource MutedTextBrush}"
                     Text="{Binding [Offline.ManagerStillWorks]}" />
          <Border Background="#FFF4ED" BorderBrush="#FFD6AE" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,0,0,22">
            <TextBlock x:Name="OfflineReason" Foreground="#9C2A10" Text="{Binding [Offline.InitialReason]}" />
          </Border>
          <WrapPanel>
            <Button Style="{StaticResource PrimaryButton}" Click="RetryConnection_Click" Content="{Binding [Action.Reconnect]}" />
            <Button Click="EditDevice_Click" Content="{Binding [Action.EditAddress]}" />
            <Button Click="ShowDiagnostics_Click" Content="{Binding [Action.ViewDiagnostics]}" />
          </WrapPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Margin="0,2,0,0">
          <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding [Offline.CheckThree]}" />
          <TextBlock Margin="0,16,0,8" FontWeight="SemiBold" Text="{Binding [Offline.CheckPower]}" />
          <TextBlock Margin="0,0,0,10" Foreground="{StaticResource MutedTextBrush}" Text="{Binding [Offline.CheckPowerDetail]}" />
          <TextBlock Margin="0,6,0,8" FontWeight="SemiBold" Text="{Binding [Offline.CheckNetwork]}" />
          <TextBlock Margin="0,0,0,10" Foreground="{StaticResource MutedTextBrush}" Text="{Binding [Offline.CheckNetworkDetail]}" />
          <TextBlock Margin="0,6,0,8" FontWeight="SemiBold" Text="{Binding [Offline.CheckService]}" />
          <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="{Binding [Offline.CheckServiceDetail]}" />
        </StackPanel>
      </Grid>

      <Grid x:Name="WizardPanel" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="WizardOutlineColumn" Width="230" />
          <ColumnDefinition x:Name="WizardOutlineGapColumn" Width="22" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="WizardOutline" Grid.Column="0" Padding="0,0,22,0"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
          <StackPanel>
            <TextBlock x:Name="WizardTitleText" FontSize="17" FontWeight="SemiBold" Text="{Binding [Wizard.Title]}" />
            <TextBlock x:Name="WizardDetailText" Margin="0,5,0,20" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="{Binding [Wizard.Detail]}" />
            <Border x:Name="Step1Marker" Padding="12" CornerRadius="5" Background="#EEF6FF" Margin="0,0,0,7">
              <TextBlock x:Name="Step1Text" Text="{Binding [Wizard.Step1]}" FontWeight="SemiBold" />
            </Border>
            <Border x:Name="Step2Marker" Padding="12" CornerRadius="5" Margin="0,0,0,7"><TextBlock x:Name="Step2Text" Text="{Binding [Wizard.Step2]}" /></Border>
            <Border x:Name="Step3Marker" Padding="12" CornerRadius="5" Margin="0,0,0,7"><TextBlock x:Name="Step3Text" Text="{Binding [Wizard.Step3]}" /></Border>
            <Border x:Name="Step4Marker" Padding="12" CornerRadius="5"><TextBlock x:Name="Step4Text" Text="{Binding [Wizard.Step4]}" /></Border>
          </StackPanel>
        </Border>

        <Grid Grid.Column="2">
          <Grid>
            <Grid x:Name="WizardStep1">
              <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                <StackPanel>
                  <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding [Wizard.Prepare.Title]}" />
                  <TextBlock Margin="0,8,0,20" Foreground="{StaticResource MutedTextBrush}"
                             Text="{Binding [Wizard.Prepare.Detail]}" />
                  <CheckBox x:Name="PrereqOs" Margin="0,8" IsChecked="False" Content="{Binding [Wizard.Prepare.Os]}" />
                  <CheckBox x:Name="PrereqAccount" Margin="0,8" IsChecked="False" Content="{Binding [Wizard.Prepare.Account]}" />
                  <CheckBox x:Name="PrereqNetwork" Margin="0,8" IsChecked="False" Content="{Binding [Wizard.Prepare.Network]}" />
                  <CheckBox x:Name="PrereqSsh" Margin="0,8" IsChecked="False" Content="{Binding [Wizard.Prepare.Ssh]}" />
                  <CheckBox x:Name="PrereqBoot" Margin="0,8" IsChecked="False" Content="{Binding [Wizard.Prepare.Boot]}" />
                  <Button Margin="0,18,0,0" HorizontalAlignment="Left" Click="OpenImagerHelp_Click" Content="{Binding [Wizard.Prepare.Blank]}" />
                </StackPanel>
              </ScrollViewer>
              <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Style="{StaticResource PrimaryButton}" Click="WizardNext_Click" Content="{Binding [Action.Next]}" />
              </StackPanel>
            </Grid>

            <Grid x:Name="WizardStep2" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                <StackPanel>
                  <TextBlock x:Name="ConnectionTitleText" FontSize="26" FontWeight="SemiBold" Text="{Binding [Wizard.Connection.Title]}" />
                  <TextBlock x:Name="ConnectionDetailText" Margin="0,8,0,18" Foreground="{StaticResource MutedTextBrush}" Text="{Binding [Wizard.Connection.Detail]}" />
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Grid.Row="0" FontWeight="SemiBold" Text="{Binding [Field.DeviceName]}" />
                    <TextBox Grid.Column="0" Grid.Row="1" x:Name="DisplayNameBox" Margin="0,6,0,3" AutomationProperties.HelpText="{Binding [Field.DeviceName.AutomationHelp]}" />
                    <TextBlock Grid.Column="0" Grid.Row="2" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="{Binding [Field.DeviceName.Help]}" />
                    <TextBlock Grid.Column="2" Grid.Row="0" FontWeight="SemiBold" Text="{Binding [Field.Host]}" />
                    <TextBox Grid.Column="2" Grid.Row="1" x:Name="HostBox" Margin="0,6,0,3" Text="raspberrypi.local" AutomationProperties.HelpText="{Binding [Field.Host.AutomationHelp]}" />
                    <TextBlock Grid.Column="2" Grid.Row="2" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="{Binding [Field.Host.Help]}" />
                  </Grid>
                  <Grid Margin="0,17,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Grid.Row="0" FontWeight="SemiBold" Text="{Binding [Field.SshUser]}" />
                    <TextBox Grid.Column="0" Grid.Row="1" x:Name="UserBox" Margin="0,6,0,3" Text="pi" />
                    <TextBlock Grid.Column="0" Grid.Row="2" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="{Binding [Field.SshUser.Help]}" />
                    <TextBlock Grid.Column="2" Grid.Row="0" FontWeight="SemiBold" Text="{Binding [Field.AuthMode]}" />
                    <ComboBox Grid.Column="2" Grid.Row="1" x:Name="AuthModeBox" Margin="0,6,0,3" SelectionChanged="AuthModeBox_SelectionChanged" SelectedIndex="0">
                        <ComboBoxItem Content="{Binding [Field.Auth.Password]}" Tag="Password" />
                        <ComboBoxItem Content="{Binding [Field.Auth.PrivateKey]}" Tag="PrivateKey" />
                    </ComboBox>
                    <TextBlock Grid.Column="2" Grid.Row="2" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="{Binding [Field.AuthMode.Help]}" />
                  </Grid>
                  <StackPanel x:Name="PasswordFields" Margin="0,17,0,0">
                    <TextBlock FontWeight="SemiBold" Text="{Binding [Field.SshPassword]}" />
                    <PasswordBox x:Name="PasswordInput" Margin="0,6,0,3" AutomationProperties.HelpText="{Binding [Field.SshPassword.AutomationHelp]}" />
                    <TextBlock FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="{Binding [Field.SshPassword.Help]}" />
                  </StackPanel>
                  <Grid x:Name="PrivateKeyFields" Margin="0,17,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="3" FontWeight="SemiBold" Text="{Binding [Field.PrivateKey]}" />
                    <TextBox Grid.Row="1" x:Name="PrivateKeyBox" Margin="0,6,0,3" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <Button Grid.Row="1" Grid.Column="2" x:Name="BrowsePrivateKeyButton" Style="{StaticResource BrowseButton}" Margin="0,6,0,3" Click="BrowsePrivateKey_Click" Content="{Binding [Action.Browse]}" />
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="3" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="{Binding [Field.PrivateKey.Help]}" />
                  </Grid>
                  <StackPanel Margin="0,17,0,0">
                    <TextBlock FontWeight="SemiBold" Text="{Binding [Field.SudoPassword]}" />
                    <PasswordBox x:Name="SudoPasswordInput" Margin="0,6,0,3"
                                 AutomationProperties.HelpText="{Binding [Field.SudoPassword.AutomationHelp]}" />
                    <TextBlock FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                               Text="{Binding [Field.SudoPassword.Help]}" />
                  </StackPanel>
                  <TextBlock x:Name="ConnectionValidationText" Margin="0,14,0,0" Foreground="{StaticResource DangerBrush}" Visibility="Collapsed" />
                </StackPanel>
              </ScrollViewer>
              <Grid Grid.Row="1" Margin="0,18,0,0">
                <Button x:Name="ConnectionBackButton" HorizontalAlignment="Left" Click="WizardBack_Click" Content="{Binding [Action.Back]}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                  <Button x:Name="TestSshButton" Click="TestSsh_Click" Content="{Binding [Action.TestSsh]}" />
                  <Button x:Name="ConnectionNextButton" Style="{StaticResource PrimaryButton}" Click="WizardNext_Click" Content="{Binding [Action.Next]}" />
                </StackPanel>
              </Grid>
            </Grid>

            <Grid x:Name="WizardStep3" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                <StackPanel>
                  <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding [Wizard.Options.Title]}" />
                  <TextBlock Margin="0,8,0,20" Foreground="{StaticResource MutedTextBrush}" Text="{Binding [Wizard.Options.Detail]}" />
                  <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                      <CheckBox x:Name="TouchDisplayCheck" IsChecked="True" FontWeight="SemiBold" Content="{Binding [Wizard.TouchDisplay]}" />
                      <TextBlock Margin="22,6,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding [Wizard.TouchDisplay.Detail]}" />
                    </StackPanel>
                  </Border>
                  <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="16">
                    <StackPanel>
                      <CheckBox x:Name="TailscaleCheck" FontWeight="SemiBold" Content="{Binding [Wizard.Tailscale]}"
                                Checked="TailscaleCheck_Changed" Unchecked="TailscaleCheck_Changed" />
                      <TextBlock Margin="22,6,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding [Wizard.Tailscale.Detail]}" />
                      <TextBlock Margin="22,5,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding [Wizard.Tailscale.Optional]}" />
                      <TextBlock Margin="22,10,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding [Wizard.Tailscale.Guide]}" />
                      <StackPanel x:Name="TailscaleOptionsPanel" Margin="22,14,0,0" Visibility="Collapsed">
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12">
                          <StackPanel>
                            <TextBlock x:Name="TailscaleWindowsStatus" TextWrapping="Wrap" Text="{Binding [Wizard.Tailscale.CheckingWindows]}" />
                            <WrapPanel Margin="0,10,0,0">
                              <Button Margin="0,0,8,0" Click="CheckWindowsTailscale_Click" Content="{Binding [Action.Retry]}" />
                              <Button Margin="0" Click="OpenTailscaleDownload_Click" Content="{Binding [Action.OpenTailscaleDownload]}" />
                            </WrapPanel>
                          </StackPanel>
                        </Border>
                        <TextBlock Margin="0,13,0,0" FontWeight="SemiBold" Text="{Binding [Wizard.Tailscale.Address]}" />
                        <TextBox x:Name="TailscaleAddressBox" Margin="0,6,0,3"
                                 AutomationProperties.HelpText="{Binding [Wizard.Tailscale.AddressAutomationHelp]}" />
                        <TextBlock FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                   Text="{Binding [Wizard.Tailscale.AddressHelp]}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
              <Grid Grid.Row="1" Margin="0,18,0,0">
                <Button HorizontalAlignment="Left" Click="WizardBack_Click" Content="{Binding [Action.Back]}" />
                <Button x:Name="OptionsNextButton" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Click="WizardNext_Click" Content="{Binding [Action.ReviewDeploy]}" />
              </Grid>
            </Grid>

            <Grid x:Name="WizardStep4" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <StackPanel>
                <TextBlock x:Name="DeployTitleText" FontSize="26" FontWeight="SemiBold" Text="{Binding [Wizard.Deploy.Title]}" />
                <TextBlock x:Name="DeploySummary" Margin="0,8,0,16" Foreground="{StaticResource MutedTextBrush}" Text="{Binding [Wizard.Deploy.Detail]}" />
              </StackPanel>
              <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Background="#F8FAFC" Padding="14">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                  <ProgressBar x:Name="DeployProgress" Height="5" Minimum="0" Maximum="100" Value="0" />
                  <TextBox Grid.Row="1" x:Name="DeployLog" VerticalContentAlignment="Stretch" Margin="0,12,0,0" BorderThickness="0" Background="Transparent"
                           FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="Wrap"
                           VerticalScrollBarVisibility="Auto" AutomationProperties.LiveSetting="Polite" />
                </Grid>
              </Border>
              <Grid Grid.Row="2" Margin="0,18,0,0">
                <Button x:Name="DeployBackButton" HorizontalAlignment="Left" Click="WizardBack_Click" Content="{Binding [Action.Back]}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                  <Button x:Name="OpenTailscaleLoginButton" Visibility="Collapsed" Click="OpenTailscaleLogin_Click"
                          Content="{Binding [Action.OpenTailscaleAuth]}" />
                  <Button x:Name="DeployButton" Style="{StaticResource PrimaryButton}" Click="Deploy_Click" Content="{Binding [Action.StartDeploy]}" />
                </StackPanel>
              </Grid>
            </Grid>
          </Grid>
        </Grid>
      </Grid>

      <Grid x:Name="DiagnosticsPanel" Visibility="Collapsed">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding [Diagnostics.Title]}" />
            <TextBlock Margin="0,6,0,16" Foreground="{StaticResource MutedTextBrush}" Text="{Binding [Diagnostics.Detail]}" />
          </StackPanel>
          <ListView Grid.Row="1" x:Name="DiagnosticsList" BorderBrush="{StaticResource BorderBrush}">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="{Binding [Diagnostics.Column.Path], Source={x:Static loc:LocalizationService.Instance}}" DisplayMemberBinding="{Binding Label}" Width="125" />
                <GridViewColumn Header="{Binding [Diagnostics.Column.Address], Source={x:Static loc:LocalizationService.Instance}}" DisplayMemberBinding="{Binding Address}" Width="270" />
                <GridViewColumn Header="{Binding [Diagnostics.Column.Result], Source={x:Static loc:LocalizationService.Instance}}" DisplayMemberBinding="{Binding Result}" Width="145" />
                <GridViewColumn Header="{Binding [Diagnostics.Column.Duration], Source={x:Static loc:LocalizationService.Instance}}" DisplayMemberBinding="{Binding Duration}" Width="85" />
              </GridView>
            </ListView.View>
          </ListView>
          <Grid Grid.Row="2" Margin="0,18,0,0">
            <Button HorizontalAlignment="Left" Click="BackFromDiagnostics_Click" Content="{Binding [Action.Back]}" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
              <Button Click="CopyDiagnostics_Click" Content="{Binding [Action.CopyDiagnostics]}" />
              <Button Style="{StaticResource PrimaryButton}" Click="RetryConnection_Click" Content="{Binding [Action.Retry]}" />
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>

      <Grid x:Name="NoticesPanel" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding [Notices.Title]}" VerticalAlignment="Center" />
          <ComboBox x:Name="NoticeSelect" Grid.Column="1" Width="220" MinHeight="34" Height="34" Padding="8,4"
                    SelectionChanged="NoticeSelect_SelectionChanged" AutomationProperties.Name="{Binding [Notices.SelectComponent]}">
            <ComboBoxItem Content="{Binding [Notices.Overview]}" Tag="Overview" />
            <ComboBoxItem Content="PetriTrace · MIT" Tag="Project" />
            <ComboBoxItem Content="MCount" Tag="MCount" /><ComboBoxItem Content="Lucide" Tag="Lucide" />
          </ComboBox>
        </Grid>
        <FlowDocumentScrollViewer Grid.Row="1" x:Name="NoticeReader" Background="Transparent" BorderThickness="0"
                                  IsToolBarVisible="False" VerticalScrollBarVisibility="Auto" />
      </Grid>

      <Grid x:Name="PrivacyPanel" Visibility="Collapsed">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
          <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding [Privacy.Title]}" />
          <TextBlock Margin="0,8,0,22" Foreground="{StaticResource MutedTextBrush}"
                     Text="{Binding [Privacy.Detail]}" />
          <TextBlock FontWeight="SemiBold" Text="{Binding [Privacy.LocalTitle]}" />
          <TextBlock Margin="0,6,0,18" Foreground="{StaticResource MutedTextBrush}"
                     Text="{Binding [Privacy.LocalDetail]}" />
          <TextBlock FontWeight="SemiBold" Text="{Binding [Privacy.RemoteTitle]}" />
          <TextBlock Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}"
                     Text="{Binding [Privacy.RemoteDetail]}" />
        </StackPanel>
      </Grid>
      </Grid>
    </Grid>
  </Grid>
  </Border>
</Window>
