<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>PetriTrace</AssemblyName>
    <RootNamespace>PiCameraControl.Manager</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\static\brand\windows-icon.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>PetriTrace</Product>
    <Description>Windows deployment and maintenance manager for PetriTrace.</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../THIRD_PARTY_NOTICES.md" LogicalName="Notices.Overview" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="Notices.Project" />
    <EmbeddedResource Include="../../tools/MCOUNT_LICENSE.txt" LogicalName="Notices.MCount" />
    <EmbeddedResource Include="../../static/icons/lucide/LICENSE.txt" LogicalName="Notices.Lucide" />
    <Resource Include="..\..\static\brand\windows-icon.ico" Link="Assets\app-icon.ico" />
    <Resource Include="..\..\static\brand\app-icon.png" Link="Assets\app-icon.png" />
    <ProjectReference Include="..\PiCameraControl.Manager.Core\PiCameraControl.Manager.Core.csproj" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>
</Project>
